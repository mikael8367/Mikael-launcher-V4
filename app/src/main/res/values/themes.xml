<resources>
    <style name="Theme.MikaelLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/mikael_green</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorSecondary">@color/mikael_gold</item>
        <item name="android:windowBackground">@color/mikael_bg</item>
        <item name="colorSurface">@color/mikael_surface</item>
        <item name="colorOnSurface">@color/mikael_text</item>
    </style>

    <style name="MikaelCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/mikael_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="MikaelSectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/mikael_green</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MikaelLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/mikael_hint</item>
    </style>

    <style name="MikaelButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="MikaelButton.Play" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/mikael_green</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MikaelButton.Gold" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/mikael_gold</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
